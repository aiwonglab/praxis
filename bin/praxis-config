#!/usr/bin/env bash
# praxis-config — read/write ~/.praxis/config.yaml
#
# Usage:
#   praxis-config get <key>          — read a config value
#   praxis-config set <key> <value>  — write a config value
#   praxis-config list               — show all config
#
# Env overrides (for testing):
#   PRAXIS_STATE_DIR  — override ~/.praxis state directory
set -euo pipefail

STATE_DIR="${PRAXIS_STATE_DIR:-$HOME/.praxis}"
CONFIG_FILE="$STATE_DIR/config.yaml"

case "${1:-}" in
  get)
    KEY="${2:?Usage: praxis-config get <key>}"
    grep -E "^${KEY}:" "$CONFIG_FILE" 2>/dev/null | tail -1 | awk '{print $2}' | tr -d '[:space:]' || true
    ;;
  set)
    KEY="${2:?Usage: praxis-config set <key> <value>}"
    VALUE="${3:?Usage: praxis-config set <key> <value>}"
    mkdir -p "$STATE_DIR"
    if grep -qE "^${KEY}:" "$CONFIG_FILE" 2>/dev/null; then
      # Portable sed -i (Linux vs macOS)
      if sed --version >/dev/null 2>&1; then
        sed -i "s/^${KEY}:.*/${KEY}: ${VALUE}/" "$CONFIG_FILE"
      else
        sed -i '' "s/^${KEY}:.*/${KEY}: ${VALUE}/" "$CONFIG_FILE"
      fi
    else
      echo "${KEY}: ${VALUE}" >> "$CONFIG_FILE"
    fi
    ;;
  list)
    cat "$CONFIG_FILE" 2>/dev/null || true
    ;;
  *)
    echo "Usage: praxis-config {get|set|list} [key] [value]"
    exit 1
    ;;
esac
